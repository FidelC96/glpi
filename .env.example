# Copia a .env y completa. .env está excluido de Git.
# Versiones fijadas (imagen oficial glpi/glpi y MariaDB LTS)
GLPI_VERSION=11.0.9
MARIADB_VERSION=11.4.13

# Exposición local. 127.0.0.1 = solo esta máquina. Cambia GLPI_BIND solo para una red de pruebas autorizada.
GLPI_BIND=127.0.0.1
GLPI_PORT=8090
TZ=America/Lima

# Base de datos (la imagen GLPI auto-instala si están las 5 variables)
GLPI_DB_HOST=db
GLPI_DB_PORT=3306
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=CAMBIAR_password_largo_aleatorio

# Cuenta de integración (se crea con scripts/setup_integration.sh; no la escribas a mano en Git)
GLPI_INTEGRATION_USER=gspn_integration
GLPI_INTEGRATION_PASSWORD=CAMBIAR_password_largo_aleatorio
# OAuth client de la API v2 (los rellena scripts/setup_integration.sh)
GLPI_OAUTH_CLIENT_ID=
GLPI_OAUTH_CLIENT_SECRET=

# --- Solo servidor (con docker-compose.server.yml) ---
# URL pública detrás de nginx; fija url_base en GLPI. Vacío en local.
GLPI_URL_BASE=https://glpi-demo.rapi.tech
# Misma URL para que seed/verify entren por nginx (vacío en local = usa GLPI_BIND:GLPI_PORT)
GLPI_BASE_URL=https://glpi-demo.rapi.tech
# Red Docker externa donde vive el contenedor nginx
PROXY_NETWORK=odoo-network
